# Base URL of the SvelteKit application (e.g. https://your-app.com)
BASE_URL=http://localhost:5173

# Magic link expiry in minutes
MAGIC_LINK_EXPIRY_MINUTES=15

# Optional from address used when logging magic links
SMTP_FROM_ADDRESS=no-reply@example.com

# Google OAuth credentials
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret

# Microsoft OAuth credentials (Entra ID)
MICROSOFT_CLIENT_ID=your-microsoft-client-id
MICROSOFT_CLIENT_SECRET=your-microsoft-client-secret

# Amazon Login with Amazon credentials
AMAZON_CLIENT_ID=your-amazon-client-id
AMAZON_CLIENT_SECRET=your-amazon-client-secret
